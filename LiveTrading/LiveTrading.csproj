<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LiveTrading</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Persistence uses reflection JsonSerializer for open polymorphic journal payloads;
         full source-gen context is not yet practical. Match Simulator/Calibration IL suppressions. -->
    <NoWarn>$(NoWarn);1591;IL2026;IL3050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Agent/Agent.csproj" />
    <ProjectReference Include="../Brokers/Brokers.csproj" />
    <ProjectReference Include="../Calibration/Calibration.csproj" />
    <ProjectReference Include="../ChartAnnotator/ChartAnnotator.csproj" />
    <ProjectReference Include="../ExecutionManager/ExecutionManager.csproj" />
    <ProjectReference Include="../PortfolioManager/PortfolioManager.csproj" />
    <ProjectReference Include="../RiskManager/RiskManager.csproj" />
    <ProjectReference Include="../TradingCore/TradingCore.csproj" />
    <ProjectReference Include="../TradeManager/TradeManager.csproj" />
    <ProjectReference Include="../TradingJournal/TradingJournal.csproj" />
  </ItemGroup>
</Project>
