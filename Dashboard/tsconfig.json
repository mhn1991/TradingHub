{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  // Tests run on Node's built-in runner (`npm test`), which needs explicit .ts import
  // specifiers and node: builtins. Neither belongs in the browser bundle typecheck, and
  // pulling @types/node in for them would widen the app's ambient types.
  "exclude": ["src/**/*.test.ts"]
}
