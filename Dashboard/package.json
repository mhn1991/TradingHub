{
  "name": "tradinghub-analysis-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "data:generate": "dotnet run --configuration Release --no-build --project ../DashboardExporter/DashboardExporter.csproj -- ./public/data/sample-replay.json",
    "data:validate": "node ./scripts/validate-replay.mjs"
  },
  "dependencies": {
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.7"
  }
}
