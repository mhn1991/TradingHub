<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TradingClassifier.ML</RootNamespace>
    <AssemblyName>TradingClassifier.ML</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Deliberately NOT AOT-compatible. Microsoft.ML relies on reflection and native LightGBM
         binaries, so nothing on the Simulator.AotSmoke path may reference this project. The Agent
         talks to ITradingModel in TradingClassifier instead, and the concrete model is injected by
         a host that is already outside the AOT graph. -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.LightGbm" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TradingClassifier/TradingClassifier.csproj" />
  </ItemGroup>
</Project>
