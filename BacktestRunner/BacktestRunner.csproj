<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BacktestRunner</RootNamespace>
    <AssemblyName>BacktestRunner</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Agent/Agent.csproj" />
    <ProjectReference Include="../Brokers/Brokers.csproj" />
    <ProjectReference Include="../ChartAnnotator/ChartAnnotator.csproj" />
    <ProjectReference Include="../DashboardContracts/DashboardContracts.csproj" />
    <ProjectReference Include="../DBManager.Abstractions/DBManager.Abstractions.csproj" />
    <ProjectReference Include="../DBManager.Postgres/DBManager.Postgres.csproj" />
    <ProjectReference Include="../TradingHub.Persistence.Postgres/TradingHub.Persistence.Postgres.csproj" />
    <ProjectReference Include="../Simulator/Simulator.csproj" />
    <ProjectReference Include="../RiskManager/RiskManager.csproj" />
    <ProjectReference Include="../TradingCore/TradingCore.csproj" />
    <ProjectReference Include="../QuantResearch.Training/QuantResearch.Training.csproj" />
    <!-- Needed to load a trained classifier and hand it to the ML agents. Without this the
         agents fall back to a no-trade model and every backtest of them reports 0 trades. -->
    <ProjectReference Include="../TradingClassifier.ML/TradingClassifier.ML.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>
</Project>
