<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>QuantResearch.Training</RootNamespace>
    <AssemblyName>QuantResearch.Training</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Orchestrates real backtests + calibration fitting; mirrors Simulator.csproj/QuantResearch.csproj -->
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Agent/Agent.csproj" />
    <ProjectReference Include="../Brokers/Brokers.csproj" />
    <ProjectReference Include="../Calibration/Calibration.csproj" />
    <ProjectReference Include="../QuantResearch/QuantResearch.csproj" />
    <ProjectReference Include="../RiskManager/RiskManager.csproj" />
    <ProjectReference Include="../Simulator/Simulator.csproj" />
    <ProjectReference Include="../TradeManager/TradeManager.csproj" />
    <ProjectReference Include="../TradingPolicies/TradingPolicies.csproj" />
  </ItemGroup>
</Project>
