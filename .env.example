# Copy this file to a local, ignored environment file before running integration tests.
# Never commit real broker credentials.

export OANDA_ACCESS_TOKEN="replace-with-oanda-practice-token"
export OANDA_ACCOUNT_ID="replace-with-oanda-practice-account-id"
export OANDA_ENVIRONMENT="Demo"

export BINANCE_API_KEY="replace-with-binance-testnet-api-key"
export BINANCE_SECRET_KEY="replace-with-binance-testnet-secret-key"
export BINANCE_ENVIRONMENT="Testnet"
unset BINANCE_BASE_URL
# Optional public-market-data endpoint override for historical Binance simulations.
# export BINANCE_MARKET_DATA_BASE_URL="https://data-api.binance.vision/"

export IG_API_KEY="replace-with-ig-demo-api-key"
export IG_IDENTIFIER="replace-with-ig-demo-identifier"
export IG_PASSWORD="replace-with-ig-demo-password"
export IG_ACCOUNT_ID="replace-with-ig-demo-account-id"
export IG_TEST_EPIC="CS.D.GBPUSD.CFD.IP"
